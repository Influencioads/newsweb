# =============================================================================
# Telugu News Platform — environment contract
# Build Instructions §14 + build brief §35.
#
# RULE: every env var introduced must be documented here in the SAME commit.
# RULE: .env is git-ignored. Never commit real credentials.
# =============================================================================

# --- Core -------------------------------------------------------------------
APP_ENV=development                  # development | staging | production
APP_NAME=Telugu News Platform
APP_URL=http://localhost:5174
CMS_URL=http://localhost:5174/admin
API_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false                       # true in staging/production (§12.3 structured logs)

# --- MySQL 8 ----------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=telugu_news
MYSQL_USER=news
MYSQL_PASSWORD=change-me-in-env
MYSQL_ROOT_PASSWORD=change-me-in-env
# Derived automatically from the parts above when left blank.
DATABASE_URL=

# --- Redis 7 ----------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6381/0
CELERY_BROKER_URL=redis://127.0.0.1:6381/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6381/2

# --- Search -----------------------------------------------------------------
MEILISEARCH_URL=http://127.0.0.1:7701
MEILISEARCH_KEY=change-me-in-env
MEILISEARCH_ARTICLES_INDEX=articles

# --- Auth (§6.2) ------------------------------------------------------------
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-generate-a-DIFFERENT-one
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15            # §1: access 15 min
JWT_REFRESH_TTL_DAYS=30              # §1: rotating refresh 30 d
PASSWORD_HASH_SCHEME=argon2          # argon2 | bcrypt  (§6.2 — never MD5/SHA)
BCRYPT_ROUNDS=12
MAX_CONCURRENT_STAFF_SESSIONS=3      # §6.2 — new login evicts oldest
LOGIN_MAX_ATTEMPTS=5                 # §6.2 — 5 attempts / 15 min
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=30
OTP_TTL_SECONDS=300
OTP_LENGTH=6
PASSWORD_RESET_TTL_MINUTES=15        # §6.2 — single use, 15 min
ENCRYPTION_KEY=change-me-32-byte-urlsafe-base64-fernet-key   # at-rest encryption for provider keys

# --- Storage (§1: Zata primary, Bunny CDN mirror) ---------------------------
STORAGE_PROVIDER=local               # local | zata | bunny | s3
STORAGE_LOCAL_PATH=./var/storage
STORAGE_LOCAL_PUBLIC_URL=http://localhost:8000/media
ZATA_ENDPOINT=https://idr01.zata.ai
ZATA_ACCESS_KEY=
ZATA_SECRET_KEY=
ZATA_BUCKET=
ZATA_REGION=idr01
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_CDN_URL=
BUNNY_PULL_ZONE=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_KEY=
BUNNY_STREAM_TOKEN_KEY=
UPLOAD_MAX_BYTES=524288000           # 500 MB — e-paper PDFs run 80-300 MB (§8.1)
UPLOAD_IMAGE_MAX_BYTES=15728640      # 15 MB

# --- AI gateway (§7.1) ------------------------------------------------------
# Keys live here and in the ai_providers table (encrypted). NEVER in the frontend bundle.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=
AI_DEFAULT_PROVIDER=gemini           # §16 item 9 default: Gemini primary for Telugu
AI_DEFAULT_TIMEOUT_MS=25000          # §7.1 — 25 s then fall back
AI_MONTHLY_BUDGET_INR=15000          # §16 item 9 default
AI_BUDGET_ALERT_PERCENT=80           # §7.1 / mockup 1j — amber marker
AI_QUOTA_STRINGER_PER_DAY=20         # §7.1 per-user rate limits
AI_QUOTA_REPORTER_PER_DAY=50
AI_SIMILARITY_BLOCK_PERCENT=85       # §7.2 — block submission above this
AI_ENABLED=false                     # false => gateway runs in stub mode, no external calls

# --- Messaging --------------------------------------------------------------
MSG91_AUTH_KEY=                      # §16 item 12 default provider
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
OTP_DEV_ECHO=true                    # dev only: return OTP in the API response. MUST be false in prod.
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
SMTP_URL=

# --- Video ------------------------------------------------------------------
YOUTUBE_API_KEY=
VIDEO_DEFAULT_PROVIDER=bunny
FFMPEG_BIN=ffmpeg

# --- E-paper (§8.1) ---------------------------------------------------------
EPAPER_VIEW_DPI=150
EPAPER_TILE_DPI=300
EPAPER_THUMB_WIDTH=400
EPAPER_TILE_SIZE=256
EPAPER_OCR_LANG=tel
TESSERACT_BIN=tesseract
PDFTOPPM_BIN=pdftoppm

# --- Security (§12.1) -------------------------------------------------------
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_UPLOAD_PER_HOUR=10
SECURE_COOKIES=false                 # true in staging/production
HSTS_ENABLED=false                   # true in production only
CSP_ENABLED=true

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
GA4_MEASUREMENT_ID=

# --- Public cache (§10.1) ---------------------------------------------------
PUBLIC_CACHE_TTL_SECONDS=60
PUBLIC_CACHE_SWR_SECONDS=300
BREAKING_CACHE_TTL_SECONDS=20        # ticker polls 20-30 s
REDIS_PORT=6381

# --- Licensed image sourcing -------------------------------------------------
IMAGE_SOURCE_PROVIDER=wikimedia       # wikimedia | openverse
# Wikimedia's API policy requires a REAL contact in the User-Agent; they return
# 403 for placeholder domains such as example.com. Set this to the publication's
# own site or editorial address before running the photo importer.
IMAGE_SOURCE_CONTACT=https://topten.news
