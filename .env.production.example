# Copy to .env.production on the server. Never commit the populated file.
APP_ENV=production
APP_NAME=Telugu News Platform
APP_URL=https://telugunews.influencioweb.com
CMS_URL=https://telugunews.influencioweb.com/admin
API_URL=https://telugunews.influencioweb.com
CORS_ORIGINS=https://telugunews.influencioweb.com
ACME_EMAIL=admin@influencioweb.com

MYSQL_DATABASE=telugu_news
MYSQL_USER=news
MYSQL_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_TO_ANOTHER_LONG_RANDOM_PASSWORD
DATABASE_URL=

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_KEY=CHANGE_TO_A_LONG_RANDOM_MASTER_KEY

JWT_SECRET=CHANGE_TO_AT_LEAST_64_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_TO_A_DIFFERENT_64_CHARACTER_SECRET
ENCRYPTION_KEY=CHANGE_TO_A_FERNET_OR_APPLICATION_ENCRYPTION_KEY
OTP_DEV_ECHO=false
SECURE_COOKIES=true
HSTS_ENABLED=true
CSP_ENABLED=true

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/var/storage
STORAGE_LOCAL_PUBLIC_URL=https://telugunews.influencioweb.com/media
AI_ENABLED=false
LOG_JSON=true
LOG_LEVEL=INFO
